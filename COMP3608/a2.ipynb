import itertools
import numpy as np
from network import *

use_momentum = False
use_softmax_ce = False

valid_data = datasets["valid"]

input_size = X_train.shape[1]
output_size = len(set(y_train))


# ----------------------------
# Hyperparameter grid
# ----------------------------
max_epochs = 100
validation_interval = 15
hidden_layers_list = [1, 2, 3]
neurons_list = [8, 16, 32]
learning_rates = [0.1, 0.01, 0.001]
momentum_betas = [0.8, 0.9, 0.95, 0.98] if use_momentum else [0.0]


def build_layers(input_size, hidden_layers, neurons, lr):
    layers = []
    in_dim = input_size

    for _ in range(hidden_layers):
        layers.append(FeedforwardLayer(in_dim, neurons, lr))
        layers.append(SigmoidLayer(neurons))
        in_dim = neurons

    layers.append(FeedforwardLayer(in_dim, output_size, lr))

    if use_softmax_ce:
        layer = layers[-1]
        if not isinstance(layer, FeedforwardLayer):
            print("last layer should be feedforward")
            exit(1)
        num_node = layer.n
        layers.append(SoftmaxLayer(num_node))

    return layers


# ----------------------------
# Grid search (NO CV)
# ----------------------------
best_loss = float("inf")
best_config = None
best_model = None
config_list = []

if use_momentum:
    grid_iter = itertools.product(
        hidden_layers_list,
        neurons_list,
        learning_rates,
        momentum_betas
    )
else:
    grid_iter = itertools.product(
        hidden_layers_list,
        neurons_list,
        learning_rates
    )


for config in grid_iter:

    if use_momentum:
        hidden_layers, neurons, lr, beta = config
    else:
        hidden_layers, neurons, lr = config
        beta = 0.0

    print(f"\nConfig: layers={hidden_layers}, neurons={neurons}, lr={lr}, beta={beta}")

    layers = build_layers(input_size, hidden_layers, neurons, lr)

    model = Network(
        layers=layers,
        use_momentum=use_momentum,
        momentum_beta=beta,
        use_softmax_ce=use_softmax_ce
    )

    model.train(datasets, max_epochs, validation_interval)

    loss = model.average_loss(valid_data)

    print("Validation loss:", loss)

    if loss < best_loss:
        best_loss = loss
        best_config = (hidden_layers, neurons, lr, beta if use_momentum else None)
        config_list.append((config, loss))

        best_layers = build_layers(input_size, hidden_layers, neurons, lr)
        best_model = Network(
            best_layers,
            use_momentum=use_momentum,
            momentum_beta=beta,
            use_softmax_ce=use_softmax_ce
        )
        best_model.train(datasets, max_epochs, validation_interval)


print("\nBest config:", best_config)
print("Best validation loss:", best_loss)

# Best config: (3, 8, 0.1, None)
# Best validation loss: 0.1517379665405756
